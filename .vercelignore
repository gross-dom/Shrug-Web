# What is not needed to build the site on Vercel. (With this file present the CLI no longer reads
# .gitignore, so what that leaves out is said again here.)
node_modules
dist
.vite
*.local
.DS_Store
.claude
.agents
tests
docs
# The design handovers are read by people, not by the build; and design/v1/reference holds screenshots that
# are kept out of the repository (.gitignore), which this file would otherwise send up with the rest
design
