{
  "name": "shrug-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shrug: the website as a desktop. A macOS-style skin built on the Stageshow kit.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:vc": "vite -c vc/vite.config.ts",
    "build:vc": "tsc --noEmit -p vc && vite build -c vc/vite.config.ts && node vc/prerender.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  }
}
