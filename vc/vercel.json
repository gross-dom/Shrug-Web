{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/drops", "destination": "/vip", "permanent": true },
    { "source": "/case-studies", "destination": "/shrug-case-studies.pdf", "permanent": false }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(people|logos|drops)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] }
  ]
}
